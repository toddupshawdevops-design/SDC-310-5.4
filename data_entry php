// Start session to store and access session variables
session_start();

// Define Cookie details
$cookie_name = "user_name";
$cookie_expiration = time() + (86400 * 30); // 30-day expiration

// Process form submission
if ($_SERVER["REQUEST_METHOD"] == "POST") {
    // Sanitize user inputs
    $input_name = isset($_POST['name']) ? htmlspecialchars(trim($_POST['name'])) : '';
    $input_dob = isset($_POST['dob']) ? htmlspecialchars(trim($_POST['dob'])) : '';

    // Store Name in Cookie
    if (!empty($input_name)) {
        setcookie($cookie_name, $input_name, $cookie_expiration, "/");
        $_COOKIE[$cookie_name] = $input_name; // Update immediate superglobal context
    }

    // Store Date of Birth in Session
    if (!empty($input_dob)) {
        $_SESSION['user_dob'] = $input_dob;
    }
}

// Retrieve stored values for input field persistence
$saved_name = isset($_COOKIE[$cookie_name]) ? $_COOKIE[$cookie_name] : '';
$saved_dob = isset($_SESSION['user_dob']) ? $_SESSION['user_dob'] : '';
?>
